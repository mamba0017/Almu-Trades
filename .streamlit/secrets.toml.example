# Copy this file to .streamlit/secrets.toml and fill in your real API key.
# .streamlit/secrets.toml is git-ignored — your key will never be committed.
# Get your key from Trading212: Settings -> API (Beta) -> generate a key
# scoped to the permissions you actually need (read-only is enough here).

T212_API_KEY = "your-trading212-api-key-here"
T212_MODE = "live"  # or "demo" for a practice account
